{
  "name": "qredential",
  "version": "0.1.0",
  "description": "Verify a digital credential from a QR code with no network connection. SD-JWT selective disclosure, offline revocation, zero dependencies.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "verifiable-credentials", "sd-jwt", "selective-disclosure", "qr", "offline",
    "mdl", "age-verification", "identity", "base45", "status-list"
  ],
  "author": "George Veras Valentim",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/george-veras/qredential.git" },
  "engines": { "node": ">=20" },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
